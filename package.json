{
  "name": "simva-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run rebuild-sqlite && tsx watch src/server.ts",
    "build": "tsc",
    "start": "npm run rebuild-sqlite && node dist/server.js",
    "lint": "eslint",
    "updateQueryDocs": "npx tsx updateQueryDocs.ts",
    "rebuild-sqlite": "npm rebuild sqlite3",
    "validate-openapi": "npx --yes @redocly/cli lint api.yaml",
    "test": "npm run rebuild-sqlite && NODE_ENV=test jest --verbose",
    "test:watch": "npm run rebuild-sqlite && NODE_ENV=test jest --watchAll --verbose",
    "test:coverage": "npm run rebuild-sqlite && NODE_ENV=test jest --coverage --verbose",
    "class-docs": "npx typedoc --entryPoints src/lib --out docs --entryPointStrategy expand"
  },
  "dependencies": {
    "@keycloak/keycloak-admin-client": "26.5.3",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "jsonwebtoken": "^9.0.3",
    "@types/jwk-to-pem": "^2.0.1",
    "jwk-to-pem": "^2.0.7",
    "async": "^3.2.6",
    "axios": "^1.13.6",
    "bloom-filters": "^3.0.4",
    "express-openapi-validator": "^5.6.2",
    "js-tracker": "github:e-ucm/js-tracker#v2.1.0-beta",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.1",
    "ms": "^2.1.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7",
    "umzug": "^3.8.2",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^7",
    "@tailwindcss/postcss": "^4",
    "@types/async": "^3.2.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
