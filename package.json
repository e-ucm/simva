{
  "name": "simva",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "update:openapi": "node dist/updateOpenAPI.js",
    "update:docs": "node dist/updateQueryDocs.js",
    "rebuild-sqlite": "npm rebuild sqlite3",
    "test": "npm run rebuild-sqlite && NODE_ENV=test jest --verbose",
    "test:watch": "npm run rebuild-sqlite && NODE_ENV=test jest --watchAll --verbose",
    "test:coverage": "npm run rebuild-sqlite && NODE_ENV=test jest --coverage --verbose"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/sequelize": "^4.28.14",
    "axios": "^1.13.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "keycloak-public-key": "^1.0.2",
    "pino": "^10.1.0",
    "pino-pretty": "^10.1.0",
    "sequelize": "^6.35.0",
    "sqlite3": "^5.1.7",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^7",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.8",
    "@types/supertest": "^6.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
