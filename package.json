{
  "name": "simva-api",
  "description": "Simva, AKA Simple Validator, AKA SurveyManager is the evolution of a tool created to integrate and ease the task of validating serious games using pre-post surveys as a control point. This version allows to create more complex studies with more variety of activities and different allocations.",
  "version": "1.0.1",
  "scripts": {
    "start": "node src/bin/www $NODE_ARGS",
    "dev": "nodemon --inspect=0.0.0.0:9229 src/bin/www $NODE_ARGS",
    "dev:profiling": "nodemon --inspect=0.0.0.0:9229 --prof --perf-basic-prof --interpreted-frames-native-stack src/bin/www $NODE_ARGS",
    "dev:clinic:doctor": "clinic doctor $CLINIC_ARGS -- node src/bin/www $NODE_ARGS",
    "dev:clinic:bubbleprof": "clinic bubbleprof $CLINIC_ARGS -- node src/bin/www $NODE_ARGS",
    "dev:clinic:flame": "clinic flame $CLINIC_ARGS -- node src/bin/www $NODE_ARGS",
    "dev:clinic:heapprofiler": "clinic heapprofiler $CLINIC_ARGS -- node src/bin/www $NODE_ARGS",
    "test": "set NODE_ENV=test&& mocha -R spec"
  },
  "dependencies": {
    "@keycloak/keycloak-admin-client": "^25.0.4",
    "async": "^3.1.0",
    "axios": "^1.7.7",
    "bcrypt": "5.1.1",
    "bloom-filters": "^3.0.1",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-body-schema": "github:e-ucm/express-body-schema#1.0.0-eucm",
    "express-fileupload": "1.5.1",
    "jsonwebtoken": "9.0.2",
    "kafkajs": "^2.2.4",
    "keycloak-public-key": "github:e-ucm/keycloak-public-key#1.0.2-eucm",
    "js-tracker": "github:e-ucm/js-tracker#scorm",
    "ltijs": "^5.9.6",
    "minio": "^8.0.1",
    "mongoose": "^5.7.8",
    "ms": "^2.1.3",
    "multiparty-express": "^0.1.9",
    "node-cron": "^3.0.3",
    "node-yaml-config": "1.0.0",
    "pino": "^9.6.0",
    "require-text": "0.0.1",
    "ssl-root-cas": "1.3.x",
    "swagger-mongoose": "github:e-ucm/swagger-mongoose#1.1.2-eucm",
    "unzipper": "0.12.3",
    "uuid": "^10.0.0",
    "xml2js": "0.6.2",
    "yaml": "^1.7.2"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "js-yaml": "^4.1.0",
    "mocha": "*",
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.0.0",
    "should": "*",
    "supertest": "*"
  }
}
